# Engine + scripts configuration. Copy to .env (never commit .env).
# `pnpm setup:devnet` fills in PROGRAM_ID / USDC_MINT / TREASURY_TOKEN_ACCOUNT and the defaults below.

# ---- Solana (devnet only; mainnet URLs are refused and the genesis hash is checked at startup) ----
SOLANA_RPC_URL=https://api.devnet.solana.com      # a private devnet RPC (e.g. QuickNode) avoids public rate limits
# SOLANA_WS_URL=                                  # optional; derived from SOLANA_RPC_URL
PROGRAM_ID=4qfLMXZTmKt71eDH4S3VNSDCRFPX7qxpPk3WZZgt2PM2
USDC_MINT=                                        # mock dUSDC created by setup:devnet (or Circle devnet USDC)
TREASURY_TOKEN_ACCOUNT=

# ---- Keys: a file path (relative to repo root), a JSON byte array, or a base58 secret ----
OPERATOR_KEYPAIR=.keys/operator.json              # fee payer, hedge recorder, settler (also program upgrade authority)
MERCHANT_KEYPAIR=.keys/merchant.json              # demo merchant (used by the web app)

# ---- Integrations (every one has a mock mode) ----
GEMINI_MODE=mock                                  # mock | sandbox   (trading is sandbox-only; other hosts are refused)
RESOLUTION_SOURCE=mock                            # mock | production | sandbox
INGEST_MODE=poll                                  # poll (websocket onLogs + backfill) | quicknode (Streams webhook + backfill)
GEMINI_API_KEY=                                   # sandbox key (GEMINI_MODE=sandbox or RESOLUTION_SOURCE=sandbox)
GEMINI_API_SECRET=
# GEMINI_ACCOUNT=primary                          # subaccount for master- keys
QUICKNODE_API_KEY=                                # Streams REST API (pnpm stream on/off)
QUICKNODE_STREAM_SECURITY_TOKEN=                  # generated by `pnpm stream on`; verifies webhook signatures

# ---- Engine ----
ENGINE_PORT=8787                                  # or PORT (Railway/hosts)
PUBLIC_ENGINE_URL=http://localhost:8787           # public https URL when deployed (QuickNode webhook target)
CORS_ORIGINS=http://localhost:3000                # comma-separated web app origins
DATABASE_PATH=engine/data/oth.sqlite
PLATFORM_MARGIN_BPS=1000                          # 10% on top of the hedge price
SALES_CUTOFF_MINUTES=12                           # stop sales before Gemini stops trading (~10 min before close)
# MOCK_ADMIN_TOKEN=                               # protects /mock/* admin endpoints (mock mode only)
# MOCK_DEFAULT_ASK=0.25
# HEDGE_MAX_ATTEMPTS=5  HEDGE_RETRY_BASE_MS=1000  SETTLER_POLL_MS=5000  BACKFILL_INTERVAL_MS=15000
