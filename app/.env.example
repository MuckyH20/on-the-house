# Web app configuration. Copy to app/.env.local (never commit it). `pnpm setup:devnet` writes these for you.

# Server-only (API routes sign as operator / demo merchant)
SOLANA_RPC_URL=https://api.devnet.solana.com      # may be a private RPC — never exposed to browsers
PROGRAM_ID=4qfLMXZTmKt71eDH4S3VNSDCRFPX7qxpPk3WZZgt2PM2
USDC_MINT=
TREASURY_TOKEN_ACCOUNT=
OPERATOR_KEYPAIR=.keys/operator.json              # on Vercel: paste the JSON byte array instead of a path
MERCHANT_KEYPAIR=.keys/merchant.json
ENGINE_URL=http://localhost:8787
PLATFORM_MARGIN_BPS=1000
# FAUCET_AMOUNT_USD=20  FAUCET_COOLDOWN_SECONDS=300

# Public (shipped to the browser — keep these free of secrets)
NEXT_PUBLIC_PRIVY_APP_ID=                         # Privy app ID (email/Google sign-in for shop owners). Empty = demo shop mode
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=4qfLMXZTmKt71eDH4S3VNSDCRFPX7qxpPk3WZZgt2PM2
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_ENGINE_URL=http://localhost:8787
